#!/usr/bin/env bash
set -euo pipefail

# Stable entry point for bundled Python tools. The launcher uses only shell
# built-ins until a usable Python 3 interpreter has been identified.
launcher_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
runtime="${launcher_dir}/../scripts/runtime.py"

if [[ ! -f "${runtime}" ]]; then
    echo "AutoSEO runtime is missing. Reinstall AutoSEO." >&2
    exit 2
fi

# An override is an executable path, not a shell command. Keeping it as one
# array element prevents command injection and supports paths containing spaces.
if [[ -n "${AUTOSEO_PYTHON:-}" ]]; then
    if "${AUTOSEO_PYTHON}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${AUTOSEO_PYTHON}" "${runtime}" "$@"
    fi
    echo "AUTOSEO_PYTHON is not a usable Python 3.10+ executable." >&2
    exit 2
fi

if command -v py >/dev/null 2>&1 && py -3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    exec py -3 "${runtime}" "$@"
fi
# Homebrew and other package managers can expose only versioned executables
# while python3 still points to an older system interpreter. Do not change PATH
# or install Python globally; use an already available compatible executable.
for candidate in python3 python python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "${candidate}" >/dev/null 2>&1 && "${candidate}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${candidate}" "${runtime}" "$@"
    fi
done

echo "AutoSEO requires Python 3.10 or newer. Tried AUTOSEO_PYTHON, py -3, python3, python, and versioned python3.10–python3.14 executables." >&2
exit 2
