#!/usr/bin/env bash
set -euo pipefail

# Stable entry point for bundled Python tools. The launcher uses only shell
# built-ins until a usable Python 3 interpreter has been identified.
launcher_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
runtime="${launcher_dir}/../scripts/runtime.py"

if [[ ! -f "${runtime}" ]]; then
    echo "AutoSEO runtime is missing. Reinstall AutoSEO." >&2
    exit 2
fi

# An override is an executable path, not a shell command. Keeping it as one
# array element prevents command injection and supports paths containing spaces.
if [[ -n "${AUTOSEO_PYTHON:-}" ]]; then
    if "${AUTOSEO_PYTHON}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${AUTOSEO_PYTHON}" "${runtime}" "$@"
    fi
    echo "AUTOSEO_PYTHON is not a usable Python 3.10+ executable." >&2
    exit 2
fi

python_is_usable() {
    "$@" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

# Use any compatible interpreter only as a read-only probe. The runtime owns
# cross-platform data-directory resolution and validates the state value before
# returning a major.minor hint. A failed probe is equivalent to no state.
probe=()
if command -v py >/dev/null 2>&1 && python_is_usable py -3; then
    probe=(py -3)
else
    for candidate in python3 python python3.14 python3.13 python3.12 python3.11 python3.10; do
        if command -v "${candidate}" >/dev/null 2>&1 && python_is_usable "${candidate}"; then
            probe=("${candidate}")
            break
        fi
    done
fi

managed_version=""
managed_python=""
if ((${#probe[@]})); then
    managed_version="$("${probe[@]}" "${runtime}" --launcher-state-python-version 2>/dev/null || true)"
    managed_python="$("${probe[@]}" "${runtime}" --launcher-state-python-path 2>/dev/null || true)"
fi

# Prefer the interpreter family that created the existing managed environment.
# Validate the actual interpreter version; the state is only a selection hint.
if [[ "${managed_version}" =~ ^3\.[0-9]+$ ]]; then
    exact_check='import sys; expected = tuple(map(int, sys.argv[1].split("."))); raise SystemExit(0 if sys.version_info[:2] == expected else 1)'
    if [[ -n "${managed_python}" ]] && "${managed_python}" -c "${exact_check}" "${managed_version}" >/dev/null 2>&1; then
        exec "${managed_python}" "${runtime}" "$@"
    fi
    if command -v py >/dev/null 2>&1 && py "-${managed_version}" -c "${exact_check}" "${managed_version}" >/dev/null 2>&1; then
        exec py "-${managed_version}" "${runtime}" "$@"
    fi
    managed_candidate="python${managed_version}"
    if command -v "${managed_candidate}" >/dev/null 2>&1 && "${managed_candidate}" -c "${exact_check}" "${managed_version}" >/dev/null 2>&1; then
        exec "${managed_candidate}" "${runtime}" "$@"
    fi
fi

# With no usable managed-state match, preserve source/manual-mode discovery.
if command -v py >/dev/null 2>&1 && python_is_usable py -3; then
    exec py -3 "${runtime}" "$@"
fi
for candidate in python3 python python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "${candidate}" >/dev/null 2>&1 && "${candidate}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${candidate}" "${runtime}" "$@"
    fi
done

echo "AutoSEO requires Python 3.10 or newer. Tried AUTOSEO_PYTHON, py -3, python3, python, and versioned python3.10–python3.14 executables." >&2
exit 2
