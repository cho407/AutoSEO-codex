{
  "schema_version": 1,
  "default_preset": "blog-centered",
  "presets": {
    "blog-centered": {"label": "중앙 정렬형 블로그", "body_alignment": "center", "heading_alignment": "center"},
    "article-readable": {"label": "왼쪽 정렬형 정보 글", "body_alignment": "left", "heading_alignment": "left"},
    "none": {"label": "자동 서식 없음"}
  },
  "styles": {
    "body": {"size": 16, "line_spacing": 1.8, "color": "#333333"},
    "intro": {"size": 16, "line_spacing": 1.8, "color": "#333333"},
    "heading2": {"size": 24, "line_spacing": 1.6, "bold": true, "color": "#333333"},
    "heading3": {"size": 20, "line_spacing": 1.6, "bold": true, "color": "#333333"},
    "heading4": {"size": 18, "line_spacing": 1.6, "bold": true, "color": "#333333"},
    "quote": {"size": 18, "line_spacing": 1.8, "color": "#333333"},
    "summary": {"size": 18, "line_spacing": 1.8, "bold": true, "color": "#333333"},
    "caption": {"size": 14, "line_spacing": 1.6, "color": "#666666"},
    "source": {"size": 14, "line_spacing": 1.8, "color": "#666666"},
    "detail": {"size": 16, "line_spacing": 1.8, "color": "#333333"}
  },
  "html_spacing": {
    "body": "margin:0 0 1.25em;word-break:keep-all;overflow-wrap:anywhere",
    "heading": "margin:2em 0 1em;padding-bottom:0.5em;border-bottom:1px solid #DDDDDD",
    "quote": "margin:1.5em 0;padding:1em;border-left:3px solid #DDDDDD;background-color:#F7F7F7",
    "caption": "margin:0.5em 0 1.5em",
    "source": "margin:0.5em 0 1.25em;overflow-wrap:anywhere",
    "image": "margin:1.75em 0;text-align:center",
    "table": "border-collapse:collapse;max-width:100%;margin:1.5em 0",
    "divider": "border:0;border-top:1px solid #DDDDDD;margin:2em 0"
  }
}
