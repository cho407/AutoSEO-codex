{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cho407/AutoSEO-codex/schema/optimization-report-v1.json",
  "title": "OptimizationReport v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "target",
    "selected_lanes",
    "readiness",
    "lanes",
    "priorities",
    "outcomes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "OptimizationReport"},
    "target": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "measured_at": {"type": ["string", "null"], "format": "date-time"},
    "selected_lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["seo", "aeo", "geo", "llmo", "neo"]}
    },
    "readiness": {
      "type": "object",
      "required": ["score", "score_displayed", "coverage_percent", "confidence", "meaning"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_displayed": {"type": "boolean"},
        "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"enum": ["low", "medium", "high"]},
        "meaning": {"type": "string"}
      }
    },
    "lanes": {"type": "array", "minItems": 1, "maxItems": 5},
    "priorities": {"type": "array"},
    "outcomes": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
