{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cho407/AutoSEO-codex/schema/trend-evidence-v1.json",
  "title": "TrendEvidence v1",
  "type": "object",
  "required": ["schema_version", "kind", "topic", "market", "language", "window", "observed_at", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "TrendEvidence"},
    "topic": {"type": "string", "minLength": 1, "maxLength": 300},
    "market": {"type": "string", "minLength": 1, "maxLength": 30},
    "language": {"type": "string", "minLength": 1, "maxLength": 30},
    "window": {"enum": ["4h", "24h", "48h", "7d", "30d"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["source_type", "url", "title"],
        "properties": {
          "source_type": {"enum": ["official-trend", "primary-source", "news", "search-result", "first-party", "public-discussion"]},
          "source_group": {"type": "string", "minLength": 1, "maxLength": 120},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "published_at": {"type": "string", "format": "date-time"},
          "event_at": {"type": "string", "format": "date-time"},
          "is_primary": {"type": "boolean"},
          "metrics": {
            "type": "object",
            "properties": {
              "velocity_index": {"type": "number", "minimum": 0, "maximum": 100},
              "trend_index": {"type": "number", "minimum": 0, "maximum": 100}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
