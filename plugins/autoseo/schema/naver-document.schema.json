{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cho407/AutoSEO-codex/schema/naver-document-v1.json",
  "title": "NaverDocument v1",
  "description": "Native design is opt-in. This schema checks structure and declared review metadata, not filesystem permissions, media bytes, semantic ordering or live editor readiness. Python validation remains authoritative.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "title",
    "background",
    "blocks",
    "tags",
    "publish_settings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "layout_preset": {"enum": ["blog-centered", "article-readable", "none"], "description": "New blog drafts select blog-centered; omission preserves legacy formatting."},
    "design_profile": {"$ref": "#/$defs/designProfile"},
    "generated_images": {
      "type": "array", "maxItems": 50,
      "description": "Generated assets must pass blog_image.py checks before upload. Real user photos do not require this metadata.",
      "items": {"type": "object", "required": ["path", "brief", "review"], "additionalProperties": false,
        "properties": {"path": {"type": "string"}, "brief": {"$ref": "blog-image-brief.schema.json"}, "review": {"$ref": "blog-image-review.schema.json"}}}
    },
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["none", "color", "image"]},
        "value": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/block"}
    },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 50}
    },
    "publish_settings": {"$ref": "#/$defs/publishSettings"},
    "editor_options": {
      "type": "object",
      "properties": {"spellcheck": {"type": "boolean"}},
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"required": ["design_profile"]},
      "then": {
        "properties": {
          "layout_preset": {"const": "none"},
          "background": {"const": {"type": "none"}},
          "blocks": {"items": {"$ref": "#/$defs/nativeBlock"}}
        }
      },
      "else": {
        "properties": {
          "blocks": {
            "items": {
              "not": {
                "anyOf": [
                  {"required": ["design_role"]},
                  {"required": ["design_review"]},
                  {"required": ["related_block_id"]},
                  {"required": ["list_marker_style"]},
                  {"required": ["spacing_before"]}
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nativeStyle": {
      "type": "object",
      "properties": {
        "size": {"type": "integer", "enum": [11, 13, 15, 16, 19, 24, 28, 30, 34, 38]},
        "bold": {"type": "boolean"},
        "alignment": {"enum": ["left", "center"]},
        "line_spacing": {"type": "number", "enum": [1.5, 1.6, 1.7, 1.8, 1.9, 2.0, 2.1]}
      },
      "additionalProperties": false
    },
    "designProfile": {
      "type": "object",
      "required": ["schema_version", "preset"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "preset": {"const": "compact-native"},
        "source_divider": {"enum": ["none", "single"]},
        "media": {"enum": ["optional", "reviewed-cover-and-explainer"]},
        "max_callouts": {"type": "integer", "enum": [0, 1, 2]},
        "roles": {
          "type": "object",
          "properties": {
            "short-answer": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [15, 16]}, "bold": {"const": false}}}]},
            "intro": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [15, 16]}, "bold": {"const": false}}}]},
            "question-heading": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [19, 24]}, "bold": {"const": true}}}]},
            "minor-heading": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [16, 19]}, "bold": {"const": true}}}]},
            "summary": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [16, 19]}, "bold": {"const": true}}}]},
            "caution": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [16, 19]}, "bold": {"const": true}}}]},
            "quote": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [16, 19]}, "bold": {"const": false}}}]},
            "body": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [15, 16]}, "bold": {"const": false}}}]},
            "detail": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [15, 16]}, "bold": {"const": false}}}]},
            "caption": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [11, 13]}, "bold": {"const": false}}}]},
            "source-heading": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [15, 16, 19]}, "bold": {"const": true}}}]},
            "source": {"allOf": [{"$ref": "#/$defs/nativeStyle"}, {"properties": {"size": {"enum": [11, 13]}, "bold": {"const": false}}}]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "designReview": {
      "type": "object",
      "required": ["approved", "sha256", "provenance", "relevance_checked"],
      "properties": {
        "approved": {"const": true},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {"enum": ["original", "licensed", "public-domain", "authorized"]},
        "relevance_checked": {"const": true}
      },
      "additionalProperties": false
    },
    "nativeBlock": {
      "type": "object",
      "properties": {"id": {}},
      "oneOf": [
        {
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "paragraph"},
            "text": {"type": "string", "minLength": 1},
            "spacing_before": {"enum": ["normal", "section"]},
            "style": {"$ref": "#/$defs/nativeStyle"},
            "links": {},
            "format_role": {},
            "design_role": {"enum": ["short-answer", "intro", "question-heading", "minor-heading", "summary", "caution", "body", "detail", "caption", "source-heading", "source"]},
            "list_marker_style": {"enum": ["neutral", "circle"]}
          }
        },
        {
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "heading"},
            "text": {"type": "string", "minLength": 1},
            "spacing_before": {"enum": ["normal", "section"]},
            "level": {},
            "style": {"$ref": "#/$defs/nativeStyle"},
            "links": {},
            "design_role": {"enum": ["question-heading", "minor-heading", "source-heading"]}
          }
        },
        {
          "required": ["type", "text"],
          "properties": {
            "type": {"const": "quote"},
            "text": {"type": "string", "minLength": 1},
            "spacing_before": {"enum": ["normal", "section"]},
            "style": {"$ref": "#/$defs/nativeStyle"},
            "links": {},
            "design_role": {"const": "quote"}
          }
        },
        {
          "required": ["type", "path", "design_role", "design_review"],
          "properties": {
            "type": {"const": "photo"},
            "path": {"type": "string", "minLength": 1},
            "design_role": {"enum": ["cover", "explainer"]},
            "design_review": {"$ref": "#/$defs/designReview"},
            "related_block_id": {}
          },
          "if": {"properties": {"design_role": {"const": "cover"}}},
          "then": {"not": {"required": ["related_block_id"]}},
          "else": {"required": ["related_block_id"]}
        },
        {
          "required": ["type"],
          "properties": {
            "type": {"const": "divider"},
            "design_role": {"const": "source-divider"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "font": {"type": "string"},
        "size": {"type": ["string", "number"]},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "underline": {"type": "boolean"},
        "strikethrough": {"type": "boolean"},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "alignment": {"enum": ["left", "center", "right", "justify"]},
        "line_spacing": {"type": ["string", "number"]},
        "superscript": {"type": "boolean"},
        "subscript": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "text": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "if": {"required": ["format_role"]},
      "then": {"properties": {"type": {"const": "paragraph"}}},
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "quote",
            "special-character",
            "divider",
            "photo",
            "group-photo",
            "sticker",
            "video",
            "place",
            "multi-attach",
            "external-link",
            "file",
            "schedule",
            "table",
            "equation",
            "template",
            "library",
            "talktalk"
          ]
        },
        "text": {"type": "string", "maxLength": 100000},
        "level": {"enum": [2, 3]},
        "style": {"$ref": "#/$defs/style"},
        "format_role": {"enum": ["body", "intro", "summary", "caption", "source", "detail"], "description": "Paragraph role; does not rewrite or reorder content."},
        "design_role": {"enum": ["short-answer", "intro", "question-heading", "minor-heading", "summary", "caution", "quote", "body", "detail", "caption", "source-heading", "source", "cover", "explainer", "source-divider"]},
        "design_review": {"$ref": "#/$defs/designReview"},
        "related_block_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "list_marker_style": {"enum": ["neutral", "circle"], "description": "Neutral adds no marker; circle is an explicit request, not verified live rendering."},
        "spacing_before": {"enum": ["normal", "section"], "description": "Explicit design_profile only; section inserts one native empty paragraph after preceding semantic text, never at the start."},
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/link"}
        },
        "path": {"type": "string"},
        "replace_path": {"type": "string"},
        "properties": {"type": "object", "minProperties": 1},
        "edit_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "object", "minProperties": 1}
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string"}
        },
        "url": {"type": "string", "format": "uri"},
        "query": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"type": "array", "maxItems": 20}
        },
        "expression": {"type": "string"},
        "template_id": {"type": "string"},
        "library_item_id": {"type": "string"},
        "talktalk_id": {"type": "string"},
        "sticker_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "publishSettings": {
      "type": "object",
      "required": [
        "mode",
        "visibility",
        "search_allowed",
        "comments_allowed",
        "sympathy_allowed",
        "ccl",
        "share_allowed"
      ],
      "properties": {
        "mode": {"enum": ["draft", "publish", "schedule"]},
        "category": {"type": ["string", "null"]},
        "visibility": {"enum": ["public", "neighbors", "private"]},
        "search_allowed": {"type": "boolean"},
        "comments_allowed": {"type": "boolean"},
        "sympathy_allowed": {"type": "boolean"},
        "ccl": {"type": "string"},
        "share_allowed": {"type": "boolean"},
        "scheduled_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
