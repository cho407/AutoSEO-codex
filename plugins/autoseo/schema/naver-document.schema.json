{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cho407/AutoSEO-codex/schema/naver-document-v1.json",
  "title": "NaverDocument v1",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "title",
    "background",
    "blocks",
    "tags",
    "publish_settings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["none", "color", "image"]},
        "value": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/block"}
    },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 50}
    },
    "publish_settings": {"$ref": "#/$defs/publishSettings"}
  },
  "$defs": {
    "style": {
      "type": "object",
      "properties": {
        "font": {"type": "string"},
        "size": {"type": ["string", "number"]},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "underline": {"type": "boolean"},
        "strikethrough": {"type": "boolean"},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "alignment": {"enum": ["left", "center", "right", "justify"]},
        "line_spacing": {"type": ["string", "number"]},
        "superscript": {"type": "boolean"},
        "subscript": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "text": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "quote",
            "divider",
            "photo",
            "group-photo",
            "sticker",
            "video",
            "place",
            "multi-attach",
            "external-link",
            "file",
            "schedule",
            "table",
            "equation",
            "template",
            "library",
            "talktalk"
          ]
        },
        "text": {"type": "string", "maxLength": 100000},
        "level": {"enum": [2, 3]},
        "style": {"$ref": "#/$defs/style"},
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/link"}
        },
        "path": {"type": "string"},
        "replace_path": {"type": "string"},
        "properties": {"type": "object", "minProperties": 1},
        "edit_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "object", "minProperties": 1}
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string"}
        },
        "url": {"type": "string", "format": "uri"},
        "query": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"type": "array", "maxItems": 20}
        },
        "expression": {"type": "string"},
        "template_id": {"type": "string"},
        "library_item_id": {"type": "string"},
        "talktalk_id": {"type": "string"},
        "sticker_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "publishSettings": {
      "type": "object",
      "required": [
        "mode",
        "visibility",
        "search_allowed",
        "comments_allowed",
        "sympathy_allowed",
        "ccl",
        "share_allowed"
      ],
      "properties": {
        "mode": {"enum": ["draft", "publish", "schedule"]},
        "category": {"type": ["string", "null"]},
        "visibility": {"enum": ["public", "neighbors", "private"]},
        "search_allowed": {"type": "boolean"},
        "comments_allowed": {"type": "boolean"},
        "sympathy_allowed": {"type": "boolean"},
        "ccl": {"type": "string"},
        "share_allowed": {"type": "boolean"},
        "scheduled_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
