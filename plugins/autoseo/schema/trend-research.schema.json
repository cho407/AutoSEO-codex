{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrendResearch v1",
  "description": "Inspected, dated category research. No numeric demand metrics may be imported from news mentions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "market", "language", "window", "queries", "observations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"const": "TrendResearch"},
    "market": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"},
    "window": {"enum": ["4h", "24h", "48h", "7d", "30d"]},
    "queries": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["query", "searched_at", "urls"],
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 500},
          "searched_at": {"type": "string", "format": "date-time"},
          "urls": {"type": "array", "maxItems": 20, "items": {"type": "string", "format": "uri", "maxLength": 2000}}
        }
      }
    },
    "observations": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyword", "title", "url", "source_type", "published_at", "observed_at", "query"],
        "properties": {
          "keyword": {"type": "string", "minLength": 1, "maxLength": 200},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "url": {"type": "string", "format": "uri", "maxLength": 2000},
          "source_type": {"enum": ["primary-source", "news"]},
          "published_at": {"type": "string", "format": "date-time"},
          "published_precision": {"enum": ["day", "timestamp"], "default": "timestamp"},
          "observed_at": {"type": "string", "format": "date-time"},
          "query": {"type": "string", "minLength": 1, "maxLength": 500},
          "categories": {
            "type": "array", "maxItems": 4, "items": {"enum": ["technology", "economy", "travel", "food", "beauty", "parenting", "health", "lifestyle", "entertainment", "sports", "culture", "politics", "society", "world"]}
          },
          "category_reason": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "allOf": [{
          "if": {"required": ["categories"], "properties": {"categories": {"minItems": 1}}},
          "then": {"required": ["category_reason"]}
        }]
      }
    }
  }
}
