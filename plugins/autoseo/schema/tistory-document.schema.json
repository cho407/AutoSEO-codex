{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cho407/AutoSEO-codex/schema/tistory-document-v1.json",
  "title": "TistoryDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "title",
    "format",
    "blocks",
    "media",
    "tags",
    "publish_settings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "format": {"enum": ["auto", "markdown", "html"]},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/block"}
    },
    "media": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/media"}
    },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 50}
    },
    "publish_settings": {"$ref": "#/$defs/publishSettings"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["background-people", "all", "none", "selected"],
          "default": "background-people"
        },
        "keep_face_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^face-[1-9][0-9]*$"}
        },
        "mosaic_face_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^face-[1-9][0-9]*$"}
        },
        "main_face_id": {
          "type": ["string", "null"],
          "pattern": "^face-[1-9][0-9]*$"
        },
        "regions": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/region"}
        },
        "padding": {"type": "number", "minimum": 0, "maximum": 1},
        "block_size": {"type": "integer", "minimum": 2, "maximum": 100},
        "strip_metadata": {"type": "boolean"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "alt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 1, "maxLength": 300},
        "caption": {"type": ["string", "null"], "maxLength": 500},
        "privacy": {"$ref": "#/$defs/privacy"}
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "text"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"enum": ["paragraph", "quote"]},
            "text": {"type": "string", "minLength": 1, "maxLength": 100000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "text"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "heading"},
            "level": {"enum": [2, 3, 4]},
            "text": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "items"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"enum": ["unordered-list", "ordered-list"]},
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {"type": "string", "minLength": 1, "maxLength": 5000}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "code"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "code"},
            "code": {"type": "string", "minLength": 1, "maxLength": 100000},
            "language": {"type": "string", "maxLength": 32}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "headers", "rows"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "table"},
            "headers": {"type": "array", "minItems": 1, "maxItems": 20},
            "rows": {"type": "array", "minItems": 1, "maxItems": 100}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "divider"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "media_id"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "type": {"const": "image"},
            "media_id": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "publishSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "category",
        "visibility",
        "comments_allowed",
        "scheduled_at"
      ],
      "properties": {
        "mode": {"enum": ["draft", "publish", "schedule"]},
        "category": {"type": ["string", "null"]},
        "visibility": {"enum": ["public", "private"]},
        "comments_allowed": {"type": "boolean"},
        "scheduled_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
